{
  "name": "edulinks-graduater-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Internal staff operations MVP for Dr.Expert Edulinks and GRADUATER",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev:api -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w frontend",
    "start:api": "npm run start:api -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "guard:sql": "npm run guard:sql -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:e2e:disposable": "npm run test:e2e:disposable -w backend",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:start": "npm run db:start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:provision": "npm run db:provision -w backend",
    "db:backup": "npm run db:backup -w backend",
    "admin:create": "npm run admin:create -w backend --",
    "docs:permissions": "npm run docs:permissions -w backend",
    "docs:schema": "npm run docs:schema -w backend",
    "demo:attestation": "npm run demo:attestation -w backend",
    "demo:academic": "npm run demo:academic -w backend",
    "demo:courier": "npm run demo:courier -w backend"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.11.0-beta.19": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
