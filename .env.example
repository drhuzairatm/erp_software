# -----------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. Placeholder values only here.
# -----------------------------------------------------------------------------

# Public base URL of the app (used in password-reset links)
APP_URL=http://localhost:3000

# Runtime connection — the LOW-PRIVILEGE application role (erp_app).
# Row-level security is enforced for this role. Never use an admin/owner URL here.
DATABASE_URL=postgres://erp_app:CHANGE_ME_APP_PASSWORD@localhost:54329/erp_dev

# Internal API (Express, backend/). Only the Next.js server calls it; never expose it to browsers or the internet.
# Loopback only for now (remote hosting not decided). One instance only (one-time request ids are kept in memory).
API_HOST=127.0.0.1
API_PORT=4000
# Where the Next.js server reaches the API
API_INTERNAL_URL=http://127.0.0.1:4000
# Shared secret that signs every Next.js → API request. Random, 32+ characters, different per environment.
# Generate one (prints nothing secret to logs if redirected into .env):  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
API_INSTANCES=1

# Admin/owner connection — used ONLY by migration, provisioning and seed scripts.
# Must never be configured in the hosting platform's runtime environment.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME_ADMIN_PASSWORD@localhost:54329/erp_dev

# Password set for the erp_app role when running `npm run db:migrate`
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Set to "true" when the DB is behind a transaction pooler (e.g. Supabase port 6543)
DATABASE_POOLED=false

# File storage: "local" (development only) or "s3" (any S3-compatible service:
# Supabase Storage S3 endpoint, Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Random 32+ character secret used to sign short-lived local download links
STORAGE_SIGNING_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# System email: staff invitations, staff password resets and security alerts.
# Provider: SMTP when all five SYSTEM_MAIL_* settings are valid; otherwise Resend when RESEND_API_KEY and EMAIL_FROM are set.
# Option 1, SMTP. Set ALL five.
# If any is missing or invalid, nothing is sent: invitation links are shown to the administrator, and staff are told to
# ask an administrator for a reset link. PORT must be 465 (implicit TLS) or 587 (STARTTLS required).
# FROM_EMAIL is one bare address, e.g. no-reply@yourcompany.com. Keep real values only in the server environment.
# NOTIFICATIONS_MODE=test stops these emails, except to NOTIFICATIONS_TEST_RECIPIENTS: see docs/NOTIFICATIONS.md, "System email".
SYSTEM_MAIL_HOST=
SYSTEM_MAIL_PORT=
SYSTEM_MAIL_FROM_EMAIL=
SYSTEM_MAIL_USER=
SYSTEM_MAIL_PASSWORD=
# Option 2, Resend. EMAIL_FROM may be a bare address or "Name <address>".
RESEND_API_KEY=
EMAIL_FROM=

# Demo seed password for fictional accounts (development/staging only)
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# Staff invitation validity in days (1–14, default 7)
STAFF_INVITE_DAYS=7

# Timezone for business dates (due today / overdue)
APP_TIMEZONE=Asia/Kolkata

# Two-factor login: key that encrypts authenticator secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Two-factor login is REQUIRED for every staff user (MD decision). Production builds ignore this setting and always
# require it. Only local development / automated tests may relax it: roles or off.
MFA_ENFORCE=all

# Virus scanning of uploads (one of the two; leave both empty = files stay "not scanned" and need manual clearance)
# ClamAV daemon (clamd) reachable from the app server:
CLAMAV_HOST=
CLAMAV_PORT=3310
# or an HTTPS scanning service: POST raw bytes, answers {"status":"clean"|"infected","signature":"..."}
SCANNER_URL=
SCANNER_TOKEN=

# --- Notifications (email / WhatsApp / SMS) — see docs/NOTIFICATIONS.md -----
# test (default): nothing is sent except to NOTIFICATIONS_TEST_RECIPIENTS. live: real sending.
NOTIFICATIONS_MODE=test
NOTIFICATIONS_TEST_RECIPIENTS=
DEFAULT_COUNTRY_CODE=91
# Email through each brand's own mailbox (SMTP connection string; suffix = company code). Student and parent email only.
# EMAIL_FROM above is also the fallback sender for a company without its own EMAIL_FROM_<CODE>.
EMAIL_SMTP_URL_EDX=
EMAIL_FROM_EDX=
EMAIL_SMTP_URL_GRD=
EMAIL_FROM_GRD=
# WhatsApp via Gallabox (API key/secret from Gallabox → Settings → API keys; channel id per brand number)
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID_EDX=
GALLABOX_CHANNEL_ID_GRD=
# GALLABOX_API_URL=https://server.gallabox.com/devapi/messages/whatsapp
# Secret for the scheduled sender (/api/cron/notifications), 32+ random characters
# Client address for rate limits and audit (audit finding M-1). Forwarding headers are believed ONLY from the
# trusted proxy configured here; see docs/DEPLOYMENT.md "Client address and reverse proxy".
#   none (default)   no forwarding header trusted: address unknown, per-address limits skipped (per-email limits still apply)
#   x-real-ip        Hostinger VPS behind Nginx/Caddy that SETS X-Real-IP to the connecting address (recommended)
#   xff-last         own proxy that APPENDS to X-Forwarded-For; TRUSTED_PROXY_HOPS = number of own proxies (default 1)
#   vercel           Vercel platform header X-Real-IP
TRUST_PROXY=none
TRUSTED_PROXY_HOPS=1

CRON_SECRET=

# Student portal: secret for sign-in codes and portal session tokens (32+ random chars; falls back to STORAGE_SIGNING_SECRET)
PORTAL_SECRET=
